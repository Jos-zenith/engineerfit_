generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Starter models — replace with your own
model User {
  id        String             @id @default(cuid())
  email     String             @unique
  name      String?
  emailVerified DateTime?
  image     String?
  createdAt DateTime           @default(now())
  profiles  AssessmentProfile[]
  accounts  Account[]
  sessions  Session[]
  assessmentSessions AssessmentSession[] @relation("AssessmentSessions")
  assessmentAttempts AssessmentAttempt[] @relation("AssessmentAttempts")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AssessmentProfile {
  id          String   @id @default(cuid())
  userId      String
  displayName String
  role        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("assessment_profiles")
}

model AssessmentSession {
  id                   String   @id @default(cuid())
  userId               String
  theta                Float    @default(0)
  asked_question_ids   String   @default("[]")
  response_history     String   @default("[]")
  status               String   @default("active")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation("AssessmentSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("assessment_sessions")
}

model AssessmentAttempt {
  id                      String   @id @default(cuid())
  userId                  String
  cognitive_score         Float?
  behavioral_score        Float?
  domain_score            Float?
  role_alignment_score    Float?
  career_hygiene_score    Float?
  retention_prediction    Float?
  overall_score           Float?
  irt_theta               Float?
  irt_score               Float?
  explanation             String?
  createdAt               DateTime @default(now())

  user User @relation("AssessmentAttempts", fields: [userId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]

  @@index([userId])
  @@map("assessment_attempts")
}

model AssessmentResponse {
  id                  String   @id @default(cuid())
  attempt_id          String
  question_id         Int
  selected_index      Int
  confidence          String
  time_spent_seconds  Float?
  is_correct          Boolean?
  createdAt           DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@index([attempt_id])
  @@index([question_id])
  @@map("assessment_responses")
}